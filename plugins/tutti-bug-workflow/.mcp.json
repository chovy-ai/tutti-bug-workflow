{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.10.1",
        "--autoConnect",
        "--categoryExperimentalWebmcp"
      ]
    },
    "tutti-web": {
      "command": "node",
      "args": [
        "./bridge/tutti-web-bridge.mjs",
        "mcp"
      ],
      "cwd": "."
    }
  }
}
