{
  "schema_version": 1,
  "deploy": {
    "branch_prefix": "codex/bug-",
    "server": {
      "repository": "tutti-lab/tutti-server",
      "workflow": "deploy-lane.yml",
      "lane_prefix": "ppe-bug-",
      "inputs": { "connector_authorization_enabled": "false" },
      "destroy_workflow": "destroy-lane.yml"
    },
    "websocket": {
      "repository": "tutti-lab/tsh-websocket",
      "workflow": "deploy-lane.yml",
      "destroy_workflow": "destroy-lane.yml",
      "infrastructure_workflow": "deploy-websocket-v2-infrastructure.yml"
    },
    "web": {
      "repository": "tutti-lab/tutti",
      "workflow": "platform-web-preview.yml",
      "dispatch_ref": "main",
      "preview_url": "https://tutti.sh/platform/?webBranch={branch}"
    },
    "computer": {
      "repository": "tutti-lab/tutti",
      "workflow": "computer-artifacts-release.yml"
    }
  },
  "repositories": [
    { "name": "tutti", "url": "https://github.com/tutti-lab/tutti.git", "base_branch": "main", "cache_path": "repositories/tutti.git", "checkout_path": "repositories/tutti" },
    { "name": "tutti-server", "url": "https://github.com/tutti-lab/tutti-server.git", "base_branch": "main", "cache_path": "repositories/tutti-server.git", "checkout_path": "repositories/tutti-server" },
    { "name": "tsh-websocket", "url": "https://github.com/tutti-lab/tsh-websocket.git", "base_branch": "main", "cache_path": "repositories/tsh-websocket.git", "checkout_path": "repositories/tsh-websocket" }
  ],
  "log_sources": [
    { "name": "web-chrome", "kind": "web", "transport": "chrome-devtools-mcp", "environment": "local_chrome", "mcp_server": "chrome-devtools", "tool": "get_web_logs", "scope": "local_account_and_page" },
    { "name": "web-export", "kind": "web", "transport": "user-export", "environment": "qa_browser", "scope": "exported_archive", "source": "Tutti 设置 → 诊断 → 导出日志" },
    { "name": "computer-local", "kind": "computer", "transport": "files", "environment": "execution_host", "paths": ["~/.tutti-amp/computer/logs/companion.log", "~/.tutti-amp/computer/logs/desktopd.log", "~/.tutti-amp/computer/logs/runtime-host.log", "${TMPDIR}/tutti-codex-appserver-startup.jsonl"], "scope": "execution_host_only" },
    { "name": "computer-remote", "kind": "computer", "transport": "mcp", "acquisition": "tutti-runtime-log-recall", "environment": null, "mcp_server": null, "tool": null, "scope": "reported_computer" }
  ],
  "validation": {
    "environment": "ppe-lane",
    "url": "https://tutti.sh/platform/",
    "revision_source": "deploy.py 返回的工作流 run headSha",
    "browser_tool": "chrome-devtools"
  },
  "tutti_ops": { "admin_url": "https://admin.tutti.sh" },
  "cli_dependencies": [
    { "name": "git", "command": "git", "required": true, "installer": null },
    { "name": "gh", "command": "gh", "required": false, "installer": null },
    { "name": "tutti-ops", "command": "tutti-ops", "required": true, "installer": { "type": "npm-global", "package": "@tutti-os/tutti-ops-cli" } }
  ],
  "mcp_servers": {},
  "trigger": { "mode": "manual", "service_url": null }
}
