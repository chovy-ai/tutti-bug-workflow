{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.10.1",
        "--autoConnect",
        "--categoryExperimentalWebmcp"
      ],
      "type": "stdio"
    },
    "tutti-web": {
      "type": "stdio",
      "command": "node",
      "args": [
        "./bridge/tutti-web-bridge.mjs",
        "mcp"
      ],
      "cwd": "."
    }
  }
}
