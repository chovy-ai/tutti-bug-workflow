{
  "manifest_version": 3,
  "name": "Tutti Bug Workflow Bridge",
  "version": "0.1.0",
  "description": "Lets local Codex agents read Tutti Web diagnostic tools on *.tutti.sh pages without Chrome remote debugging.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "alarms", "storage"],
  "host_permissions": ["https://*.tutti.sh/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.tutti.sh/*"],
      "js": ["page-main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://*.tutti.sh/*"],
      "js": ["page-isolated.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": { "default_title": "Tutti Bug Workflow Bridge", "default_popup": "popup.html" }
}
